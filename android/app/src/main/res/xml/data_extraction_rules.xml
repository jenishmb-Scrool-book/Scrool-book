<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31 и выше). Здесь два независимых канала, и правила у них
    разные намеренно.

    cloud-backup — копия в Google Диск пользователя. Тексты книг и картинки из
    них исключены: квота 25 МБ, которую крупные книги выбирают целиком, и заодно
    чужой текст не уезжает с телефона вообще никуда.

    device-transfer — прямой перенос со старого телефона на новый. Здесь ни
    квоты, ни облака нет, так что книги переносим: это ровно тот случай, когда
    пользователь ждёт, что всё окажется на месте.

    Старые версии Android читают backup_rules.xml — правки нужны в обоих файлах.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="books" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
