<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила облачного бэкапа для Android 11 и старше (API 23–30).
    На Android 12+ действует data_extraction_rules.xml — держать их
    согласованными придётся руками, платформа их не связывает.

    Тексты книг из бэкапа исключены, и не только ради приватности.
    У Auto Backup квота 25 МБ на приложение: пара крупных fb2 её выбирает, и
    тогда Android перестаёт бэкапить приложение ЦЕЛИКОМ — вместе с позицией
    чтения. А позиция и есть то единственное, что нельзя переимпортировать.

    Плата за это: после восстановления на новом телефоне книга в списке есть,
    а текста у неё нет, пока файл не добавят заново.
-->
<full-backup-content>
    <exclude domain="file" path="books" />
</full-backup-content>
