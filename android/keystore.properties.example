# Скопируйте этот файл в android/keystore.properties и впишите свои значения.
# Сам keystore.properties в гит не попадает — он в .gitignore.
#
# ВАЖНО: пароли сюда вписываете вы сами, руками. Ни в коде, ни в истории
# команд их быть не должно.

# Путь к файлу ключа. Считается от папки android/, но лучше указать
# абсолютный путь куда-нибудь вне репозитория — так его нельзя закоммитить
# даже случайно, например:
#   storeFile=C:/Users/<вы>/keys/scroolbook-upload.jks
storeFile=

# Пароль хранилища ключей
storePassword=

# Псевдоним ключа (тот, что задавали в keytool -alias)
keyAlias=scroolbook-upload

# Пароль самого ключа
keyPassword=
